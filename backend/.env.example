# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Hindsight Memory API Configuration (Official API: https://hindsight.vectorize.io)
# Cloud API endpoint: https://api.hindsight.vectorize.io
# Local Docker endpoint: http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incidentiq-ops-bank

# Server Port
PORT=3001
