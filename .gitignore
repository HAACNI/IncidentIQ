# ==========================================
# IncidentIQ Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Environment variables, credentials, and secrets (MANDATORY)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Production & build outputs
dist/
dist-ssr/
*/dist/
build/
*/build/
out/
*.local

# Logs and runtime caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime session history data
backend/data/*.json
!backend/data/.gitkeep

# Operating system & Editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp
*.bak
